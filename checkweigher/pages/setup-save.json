              {
                "id": "sus-act",
                "type": "Container",
                "name": "Save / discard",
                "properties": {
                  "showWhenEmpty": true,
                  "background": "transparent"
                },
                "layout": {
                  "direction": "row",
                  "gap": "12px",
                  "wrap": false,
                  "align": "stretch",
                  "justify": "flex-start",
                  "radius": "0",
                  "paddingTop": "0px",
                  "paddingRight": "0px",
                  "paddingBottom": "0px",
                  "paddingLeft": "0px",
                  "widthMode": "fill",
                  "heightMode": "hug"
                },
                "children": [
                  {
                    "id": "sus-save",
                    "type": "Button",
                    "name": "Save",
                    "properties": {
                      "label": {
                        "$loc": "SAVE"
                      },
                      "variant": "outline",
                      "fill": {
                        "$if": {
                          "condition": {
                            "$or": [
                              {
                                "$recipe": {
                                  "type": "machine",
                                  "field": "parametersChanged"
                                }
                              },
                              {
                                "$recipe": {
                                  "type": "product",
                                  "field": "parametersChanged"
                                }
                              }
                            ]
                          },
                          "true": "var(--hmi-accent)",
                          "false": "var(--hmi-surface-raised)"
                        }
                      },
                      "color": {
                        "$if": {
                          "condition": {
                            "$or": [
                              {
                                "$recipe": {
                                  "type": "machine",
                                  "field": "parametersChanged"
                                }
                              },
                              {
                                "$recipe": {
                                  "type": "product",
                                  "field": "parametersChanged"
                                }
                              }
                            ]
                          },
                          "true": "#111316",
                          "false": "var(--hmi-text-muted)"
                        }
                      },
                      "radius": "10px",
                      "borderWidth": 0,
                      "actions": {
                        "onPress": [
                          {
                            "type": "if",
                            "condition": {
                              "$or": [
                                {
                                  "$recipe": {
                                    "type": "machine",
                                    "field": "parametersChanged"
                                  }
                                },
                                {
                                  "$recipe": {
                                    "type": "product",
                                    "field": "parametersChanged"
                                  }
                                }
                              ]
                            },
                            "then": [
                              {
                                "type": "recipeSave",
                                "datasetId": "saved",
                                "onSuccess": [
                                  {
                                    "type": "recipeLoad",
                                    "datasetId": "saved",
                                    "verify": false
                                  },
                                  {
                                    "type": "recipeSave",
                                    "datasetId": {
                                      "$recipe": {
                                        "type": "product",
                                        "field": "activeName"
                                      }
                                    },
                                    "onSuccess": [
                                      {
                                        "type": "showToast",
                                        "message": {
                                          "$loc": "Parameters saved"
                                        },
                                        "severity": "success",
                                        "discard": "auto",
                                        "duration": 2600
                                      }
                                    ],
                                    "onFailed": [
                                      {
                                        "type": "showToast",
                                        "message": {
                                          "$loc": {
                                            "key": "Save failed: {1}",
                                            "wildcards": {
                                              "1": {
                                                "$result": "reason"
                                              }
                                            }
                                          }
                                        },
                                        "severity": "error",
                                        "discard": "auto",
                                        "duration": 2600
                                      }
                                    ]
                                  }
                                ],
                                "onFailed": [
                                  {
                                    "type": "showToast",
                                    "message": {
                                      "$loc": {
                                        "key": "Save failed: {1}",
                                        "wildcards": {
                                          "1": {
                                            "$result": "reason"
                                          }
                                        }
                                      }
                                    },
                                    "severity": "error",
                                    "discard": "auto",
                                    "duration": 2600
                                  }
                                ]
                              }
                            ],
                            "else": [
                              {
                                "type": "showToast",
                                "message": {
                                  "$loc": "No changes to save"
                                },
                                "severity": "info",
                                "discard": "auto",
                                "duration": 2600
                              }
                            ]
                          }
                        ]
                      }
                    },
                    "layout": {
                      "widthMode": "fill",
                      "heightMode": "fixed",
                      "height": "56px"
                    }
                  },
                  {
                    "id": "sus-discard",
                    "type": "Button",
                    "name": "Discard",
                    "properties": {
                      "label": {
                        "$loc": "DISCARD"
                      },
                      "variant": "outline",
                      "fill": "var(--hmi-surface-raised)",
                      "color": "var(--hmi-text)",
                      "radius": "10px",
                      "borderWidth": 0,
                      "actions": {
                        "onPress": [
                          {
                            "type": "recipeLoad",
                            "datasetId": "saved",
                            "verify": false
                          },
                          {
                            "type": "recipeLoad",
                            "datasetId": {
                              "$recipe": {
                                "type": "product",
                                "field": "activeName"
                              }
                            },
                            "verify": false
                          },
                          {
                            "type": "showToast",
                            "message": {
                              "$loc": "Changes discarded"
                            },
                            "severity": "info",
                            "discard": "auto",
                            "duration": 2600
                          }
                        ]
                      }
                    },
                    "layout": {
                      "widthMode": "fill",
                      "heightMode": "fixed",
                      "height": "56px"
                    }
                  }
                ]
              },
              {
                "id": "sus-factory",
                "type": "Button",
                "name": "Factory reset",
                "properties": {
                  "label": {
                    "$loc": "RESET TO FACTORY DEFAULTS"
                  },
                  "variant": "outline",
                  "fill": "transparent",
                  "color": "var(--hmi-fault)",
                  "radius": "10px",
                  "borderWidth": 2,
                  "actions": {
                    "onPress": [
                      {
                        "type": "writeDataVariable",
                        "target": {
                          "$var": {
                            "path": "CW:Params/Lower"
                          }
                        },
                        "value": -30
                      },
                      {
                        "type": "writeDataVariable",
                        "target": {
                          "$var": {
                            "path": "CW:Params/Upper"
                          }
                        },
                        "value": 30
                      },
                      {
                        "type": "writeDataVariable",
                        "target": {
                          "$var": {
                            "path": "CW:Params/Band"
                          }
                        },
                        "value": 10
                      },
                      {
                        "type": "writeDataVariable",
                        "target": {
                          "$var": {
                            "path": "CW:Params/Tare"
                          }
                        },
                        "value": 180
                      },
                      {
                        "type": "writeDataVariable",
                        "target": {
                          "$var": {
                            "path": "CW:Params/Filter"
                          }
                        },
                        "value": 250
                      },
                      {
                        "type": "writeDataVariable",
                        "target": {
                          "$var": {
                            "path": "CW:Params/ZeroInt"
                          }
                        },
                        "value": 60
                      },
                      {
                        "type": "writeDataVariable",
                        "target": {
                          "$var": {
                            "path": "CW:Params/RejDelay"
                          }
                        },
                        "value": 350
                      },
                      {
                        "type": "writeDataVariable",
                        "target": {
                          "$var": {
                            "path": "CW:Params/RejPulse"
                          }
                        },
                        "value": 120
                      },
                      {
                        "type": "writeDataVariable",
                        "target": {
                          "$var": {
                            "path": "CW:Params/BinCap"
                          }
                        },
                        "value": 30
                      },
                      {
                        "type": "writeDataVariable",
                        "target": {
                          "$var": {
                            "path": "CW:Params/Speed"
                          }
                        },
                        "value": 0.8
                      },
                      {
                        "type": "writeDataVariable",
                        "target": {
                          "$var": {
                            "path": "CW:Params/Gap"
                          }
                        },
                        "value": 180
                      },
                      {
                        "type": "showToast",
                        "message": {
                          "$loc": "Factory defaults loaded · save to apply permanently"
                        },
                        "severity": "warning",
                        "discard": "auto",
                        "duration": 2600
                      }
                    ]
                  }
                },
                "layout": {
                  "widthMode": "fill",
                  "heightMode": "fixed",
                  "height": "56px"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}