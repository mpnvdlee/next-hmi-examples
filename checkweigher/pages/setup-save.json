{
  "id": "setup-save",
  "title": {
    "$loc": "Save & Reset"
  },
  "mainBackground": "var(--hmi-bg)",
  "mainPadding": "16px",
  "sections": {
    "content": [
      {
        "id": "susav",
        "type": "Container",
        "name": "Page",
        "properties": {
          "showWhenEmpty": true,
          "background": "transparent"
        },
        "layout": {
          "direction": "row",
          "gap": "16px",
          "wrap": false,
          "align": "stretch",
          "justify": "flex-start",
          "radius": "0",
          "paddingTop": "0px",
          "paddingRight": "0px",
          "paddingBottom": "0px",
          "paddingLeft": "0px",
          "widthMode": "fill",
          "heightMode": "fill"
        },
        "children": [
          {
            "id": "susav-nav",
            "type": "$component:setup-nav",
            "name": "Sections",
            "properties": {
              "calSub": {
                "$if": {
                  "condition": {
                    "$or": [
                      {
                        "$var": {
                          "path": "CW:Alarms/ZeroDue"
                        }
                      },
                      {
                        "$var": {
                          "path": "CW:Alarms/Drift"
                        }
                      }
                    ]
                  },
                  "true": {
                    "$loc": "Zero needed"
                  },
                  "false": {
                    "$loc": "OK"
                  }
                }
              },
              "rejectSub": {
                "$loc": {
                  "key": "Bin {1}/{2}",
                  "wildcards": {
                    "1": {
                      "$var": {
                        "path": "CW:IO/BinLevel"
                      }
                    },
                    "2": {
                      "$var": {
                        "path": "CW:Params/BinCap"
                      }
                    }
                  }
                }
              },
              "calSubColor": {
                "$if": {
                  "condition": {
                    "$or": [
                      {
                        "$var": {
                          "path": "CW:Alarms/ZeroDue"
                        }
                      },
                      {
                        "$var": {
                          "path": "CW:Alarms/Drift"
                        }
                      }
                    ]
                  },
                  "true": "var(--hmi-warn)",
                  "false": "var(--hmi-text-muted)"
                }
              },
              "rejectSubColor": {
                "$if": {
                  "condition": {
                    "$var": {
                      "path": "CW:Alarms/BinFull"
                    }
                  },
                  "true": "var(--hmi-warn)",
                  "false": "var(--hmi-text-muted)"
                }
              }
            },
            "layout": {
              "widthMode": "fixed",
              "heightMode": "hug",
              "width": "156px"
            }
          },
          {
            "id": "susav-body",
            "type": "Container",
            "name": "Section",
            "properties": {
              "showWhenEmpty": true,
              "background": "transparent",
              "overflow": "scroll"
            },
            "layout": {
              "direction": "column",
              "gap": "8px",
              "wrap": false,
              "align": "stretch",
              "justify": "flex-start",
              "radius": "0",
              "paddingTop": "0px",
              "paddingRight": "0px",
              "paddingBottom": "0px",
              "paddingLeft": "0px",
              "widthMode": "fill",
              "heightMode": "fill",
              "minWidth": "0"
            },
            "children": [
              {
                "id": "susav-bh",
                "type": "$component:section-header",
                "name": "Section header",
                "properties": {
                  "title": {
                    "$loc": "SAVE & RESET"
                  },
                  "subtitle": {
                    "$if": {
                      "condition": {
                        "$or": [
                          {
                            "$recipe": {
                              "type": "machine",
                              "field": "parametersChanged"
                            }
                          },
                          {
                            "$recipe": {
                              "type": "product",
                              "field": "parametersChanged"
                            }
                          }
                        ]
                      },
                      "true": {
                        "$loc": "Unsaved changes"
                      },
                      "false": {
                        "$loc": "All saved"
                      }
                    }
                  }
                },
                "layout": {
                  "widthMode": "fill",
                  "heightMode": "fixed",
                  "height": "32px"
                }
              },
              {
                "id": "sus-changes",
                "type": "Container",
                "name": "Changes",
                "properties": {
                  "showWhenEmpty": true,
                  "background": "var(--hmi-surface)"
                },
                "layout": {
                  "direction": "column",
                  "gap": "6px",
                  "wrap": false,
                  "align": "stretch",
                  "justify": "flex-start",
                  "radius": "10px",
                  "paddingTop": "14px",
                  "paddingRight": "16px",
                  "paddingBottom": "14px",
                  "paddingLeft": "16px",
                  "widthMode": "fill",
                  "heightMode": "hug"
                },
                "children": [
                  {
                    "id": "sus-ch-s",
                    "type": "Label",
                    "name": "Status",
                    "properties": {
                      "typography": "body",
                      "text": {
                        "$if": {
                          "condition": {
                            "$compare": {
                              "left": {
                                "$formula": {
                                  "expression": "{1} + {2}",
                                  "wildcards": {
                                    "1": {
                                      "$recipe": {
                                        "type": "product",
                                        "field": "changedCount"
                                      }
                                    },
                                    "2": {
                                      "$recipe": {
                                        "type": "machine",
                                        "field": "changedCount"
                                      }
                                    }
                                  }
                                }
                              },
                              "operator": ">",
                              "right": 0
                            }
                          },
                          "true": {
                            "$if": {
                              "condition": {
                                "$compare": {
                                  "left": {
                                    "$formula": {
                                      "expression": "{1} + {2}",
                                      "wildcards": {
                                        "1": {
                                          "$recipe": {
                                            "type": "product",
                                            "field": "changedCount"
                                          }
                                        },
                                        "2": {
                                          "$recipe": {
                                            "type": "machine",
                                            "field": "changedCount"
                                          }
                                        }
                                      }
                                    }
                                  },
                                  "operator": "===",
                                  "right": 1
                                }
                              },
                              "true": {
                                "$loc": "1 unsaved change"
                              },
                              "false": {
                                "$loc": {
                                  "key": "{1} unsaved changes",
                                  "wildcards": {
                                    "1": {
                                      "$formula": {
                                        "expression": "{1} + {2}",
                                        "wildcards": {
                                          "1": {
                                            "$recipe": {
                                              "type": "product",
                                              "field": "changedCount"
                                            }
                                          },
                                          "2": {
                                            "$recipe": {
                                              "type": "machine",
                                              "field": "changedCount"
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            }
                          },
                          "false": {
                            "$loc": "All parameters saved"
                          }
                        }
                      },
                      "wrap": "truncate",
                      "color": {
                        "$if": {
                          "condition": {
                            "$compare": {
                              "left": {
                                "$formula": {
                                  "expression": "{1} + {2}",
                                  "wildcards": {
                                    "1": {
                                      "$recipe": {
                                        "type": "product",
                                        "field": "changedCount"
                                      }
                                    },
                                    "2": {
                                      "$recipe": {
                                        "type": "machine",
                                        "field": "changedCount"
                                      }
                                    }
                                  }
                                }
                              },
                              "operator": ">",
                              "right": 0
                            }
                          },
                          "true": "var(--hmi-warn)",
                          "false": "var(--hmi-ok)"
                        }
                      },
                      "size": "17px",
                      "weight": 600
                    },
                    "layout": {
                      "widthMode": "hug",
                      "heightMode": "hug"
                    }
                  },
                  {
                    "id": "sus-ch-i",
                    "type": "Label",
                    "name": "Info",
                    "properties": {
                      "typography": "body",
                      "text": {
                        "$if": {
                          "condition": {
                            "$compare": {
                              "left": {
                                "$recipe": {
                                  "type": "machine",
                                  "field": "savedAt",
                                  "format": "HH:mm"
                                }
                              },
                              "operator": "===",
                              "right": ""
                            }
                          },
                          "true": {
                            "$loc": "Not saved yet · changes apply immediately, SAVE stores them permanently"
                          },
                          "false": {
                            "$loc": {
                              "key": "Last saved {1} · changes apply immediately, SAVE stores them permanently",
                              "wildcards": {
                                "1": {
                                  "$recipe": {
                                    "type": "machine",
                                    "field": "savedAt",
                                    "format": "HH:mm"
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "wrap": "truncate",
                      "color": "var(--hmi-text-muted)",
                      "size": "13px"
                    },
                    "layout": {
                      "widthMode": "hug",
                      "heightMode": "hug"
                    }
                  },
                  {
                    "id": "sus-ch-target",
                    "type": "$component:change-row",
                    "name": "Target weight",
                    "properties": {
                      "label": {
                        "$loc": "Target weight"
                      },
                      "saved": {
                        "$stringExpr": {
                          "template": "{Round(1)} g",
                          "wildcards": {
                            "1": {
                              "$recipe": {
                                "type": "product",
                                "field": "parameterValue",
                                "parameter": "target"
                              }
                            }
                          }
                        }
                      },
                      "live": {
                        "$stringExpr": {
                          "template": "{Round(1)} g",
                          "wildcards": {
                            "1": {
                              "$var": {
                                "path": "CW:Product/Target"
                              }
                            }
                          }
                        }
                      },
                      "visible": {
                        "$recipe": {
                          "type": "product",
                          "field": "parameterChanged",
                          "parameter": "target"
                        }
                      }
                    },
                    "layout": {
                      "widthMode": "fill",
                      "heightMode": "hug"
                    }
                  },
                  {
                    "id": "sus-ch-lower",
